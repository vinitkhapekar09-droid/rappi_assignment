# Local demonstration only; these are disposable database credentials.
RAPPI_DB_PORT=55432
RAPPI_API_PORT=8000
RAPPI_WEB_PORT=5173
RAPPI_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
AGENT_LLM_PROVIDER=openai_compatible
# Groq production model documented for strict Structured Outputs.
AGENT_LLM_MODEL=openai/gpt-oss-120b
# Put your Groq API key in the private root .env, never in this example.
AGENT_LLM_API_KEY=
AGENT_LLM_BASE_URL=https://api.groq.com/openai/v1
AGENT_LLM_TIMEOUT_SECONDS=30
AGENT_OFFLINE=false
# Explicit credential-free fallback for local/CI use: AGENT_LLM_PROVIDER=offline
