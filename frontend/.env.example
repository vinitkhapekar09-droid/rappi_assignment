# API mode: "mock" (in-browser fixtures, no backend required) or "http" (real FastAPI backend).
VITE_API_MODE=http

# Base URL for the backend when VITE_API_MODE=http. The API contract base path is /api/v1.
# Leave empty to use the Vite /api proxy (also works in forwarded Codespaces ports).
VITE_API_BASE_URL=
