# Copy to `.env` and adjust for your environment. Never commit real secrets.

# PostgreSQL connection used by the app and Alembic.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
RAPPI_DATABASE_URL=postgresql+psycopg://rappi:rappi@localhost:55432/rappi
RAPPI_MOCK_DATABASE_PATH=mock-orders.sqlite3
RAPPI_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
AGENT_LLM_PROVIDER=openai_compatible
# Groq production model documented for strict Structured Outputs.
AGENT_LLM_MODEL=openai/gpt-oss-120b
# Configure the key privately in the root .env for Compose, never here.
AGENT_LLM_API_KEY=
AGENT_LLM_BASE_URL=https://api.groq.com/openai/v1
AGENT_LLM_TIMEOUT_SECONDS=30
AGENT_OFFLINE=false

# Idempotency lease timeout in seconds (default 60).
RAPPI_IDEMPOTENCY_LEASE_SECONDS=60

# Planning horizon is fixed at seven days by the assignment.
RAPPI_PLANNING_HORIZON_DAYS=7
